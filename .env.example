# ─────────────────────────────────────────────────────────────────────────────
# KRT Assist — configuration
#
# Only what a deployment actually has to decide. Everything omitted has a
# working default in code; the full list, with those defaults, is in
# docs/environment-variables.md.
#
# Two rules worth knowing before you start:
#
#   1. A pipeline module runs only when it is BOTH switched on and given a key.
#      `<MODULE>_ENABLED=true` alone does nothing without credentials, and a key
#      alone does nothing without the flag. This is opt-in on purpose: an
#      unconfigured module costs nothing and reports itself as "off" rather than
#      as "found nothing".
#   2. Anything set here PINS that value. If you copy a default in and the
#      default later changes, this file quietly wins. Set what you mean to
#      control, and leave the rest out.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED — the server exits at boot without these
# ═════════════════════════════════════════════════════════════════════════════

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asap_krsync_dev

# At least 32 characters in production, where the length is enforced.
JWT_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# This deployment
# ═════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000

# Where the browser reaches the app. In production this must be https:// — the
# server refuses to start otherwise, because the session cookie is Secure and
# would silently never be sent.
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Optional, and worth setting on a server: recorded on every pipeline run as
# `app_version`. Without it a run records the package version alone, which
# cannot tell two deploys of the same version apart.
# GIT_SHA=


# ═════════════════════════════════════════════════════════════════════════════
# Storage — S3, or anything speaking its API
# ═════════════════════════════════════════════════════════════════════════════

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=asap-kr-sync

# Keeps environments apart inside one bucket. Include the trailing slash.
S3_BUCKET_PREFIX=dev/

# Only for MinIO or another S3-compatible service. Leave unset for real AWS.
# S3_ENDPOINT=http://localhost:9000


# ═════════════════════════════════════════════════════════════════════════════
# The language model
#
# Nine modules call Gemini. One key covers all of them; a per-module
# `<MODULE>_GEMINI_API_KEY` overrides it where you need a separate quota.
# ═════════════════════════════════════════════════════════════════════════════

GEMINI_API_KEY=

# Applies to every module unless one overrides it. Left unset, each module uses
# the version the code ships with — which is usually what you want, so that an
# upgrade reaches this deployment instead of being pinned here for ever.
# GEMINI_MODEL=gemini-2.5-flash


# ═════════════════════════════════════════════════════════════════════════════
# Pipeline modules
#
# Each needs `=true` here AND the credentials its service requires. A module
# left off is reported as "off" throughout the app, so an empty result reads as
# a configuration choice rather than as a finding about the manuscript.
# ═════════════════════════════════════════════════════════════════════════════

# ── Reading the manuscript ───────────────────────────────────────────────────
# Everything downstream reads the converted text, so this one is effectively
# mandatory for the pipeline to be useful.
PDF_MARKDOWN_ENABLED=true
PDF_MARKDOWN_MODAL_API_URL=
PDF_MARKDOWN_MODAL_API_KEY=

# ── Authors ──────────────────────────────────────────────────────────────────
GROBID_API_ENABLED=true
GROBID_API_BASE_URL=http://localhost:8070
OPENALEX_API_ENABLED=true
# Courtesy contact, so OpenAlex puts you in its polite pool.
OPENALEX_MAILTO=

# ── Detection (Gemini, unless noted) ─────────────────────────────────────────
DAS_EXTRACTION_ENABLED=true
DATASETS_DETECTION_ENABLED=true
MATERIALS_DETECTION_ENABLED=true
PROTOCOLS_DETECTION_ENABLED=true

# Software detection runs two engines and has no single switch: Softcite below,
# and a Gemini pass. Either alone still produces a result — the run is then
# recorded as PARTIAL, and says which engine was missing.
SOFTCITE_API_ENABLED=true
SOFTCITE_API_BASE_URL=http://localhost:8050
SOFTWARE_DETECTION_LM_ENABLED=true

# ── Reconciling with the author's table ──────────────────────────────────────
# KRT Grounding has no enable flag: its deterministic matcher always runs, so
# the step is never off. Only its optional LM second look can be turned off,
# which settles fewer rows rather than producing nothing.
# KRT_GROUNDING_SECOND_LOOK_ENABLED=false
KRT_GENERATION_ENABLED=true
KRT_COMPARISON_ENABLED=true
DAS_SUGGESTIONS_ENABLED=true

# ── PDF analysis ─────────────────────────────────────────────────────────────
# Consolidates every detector's findings into the Generated KRT. It calls no
# service of its own — its LM pass goes through KRT Generation above — so the
# flag is all there is.
PDF_ANALYSIS_ENABLED=true


# ═════════════════════════════════════════════════════════════════════════════
# Demo data
#
# When a module is off or its service fails, it can answer from a canned result
# for the demo manuscripts. On by default, which is right for a demo instance
# and wrong for a real one: a canned answer is indistinguishable from a real one
# in the report, and the run only says `source: demo` in its own record.
#
# Turn it off wherever the results matter:
#   <MODULE>_DEMO_DATA_ENABLED=false
# ═════════════════════════════════════════════════════════════════════════════

# DAS_EXTRACTION_DEMO_DATA_ENABLED=false
# DATASETS_DETECTION_DEMO_DATA_ENABLED=false
# MATERIALS_DETECTION_DEMO_DATA_ENABLED=false
# PROTOCOLS_DETECTION_DEMO_DATA_ENABLED=false
# SOFTWARE_DETECTION_DEMO_DATA_ENABLED=false
# PDF_MARKDOWN_DEMO_DATA_ENABLED=false
# PDF_ANALYSIS_DEMO_DATA_ENABLED=false


# ═════════════════════════════════════════════════════════════════════════════
# ASAP Hub login (optional)
#
# Leave AUTH0_ENABLED=false for local work; the app's own email/password login
# is always available. On EC2 the credentials come from AWS Secrets Manager via
# AUTH0_SECRET_ID instead of from this file.
# ═════════════════════════════════════════════════════════════════════════════

AUTH0_ENABLED=false
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_AUDIENCE=
# AUTH0_SECRET_ID=


# ═════════════════════════════════════════════════════════════════════════════
# Occasionally useful
# ═════════════════════════════════════════════════════════════════════════════

# Where this deployment's code lives. The UI links a result to the prompt that
# produced it, so a reader can open exactly what was asked.
SOURCE_REPO_URL=https://github.com/DataSeer/asap-kr-sync
# SOURCE_BRANCH defaults to `main` in production and `dev` otherwise.
# SOURCE_BRANCH=

# The KRT template offered as a download in the app.
# KRT_TEMPLATE_URL=

# `markitdown` runs a local Python subprocess instead of calling Modal.
# PYTHON_BIN=python3

# LOG_LEVEL=http

# Rate limits, timeouts, retry policy, langextract tuning and the AI-suggestion
# suppression filter all have defaults that suit every deployment so far.
# See docs/environment-variables.md before overriding one.
